{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "./worker.ts",
  "name": "slt",
  "compatibility_date": "2025-04-08",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "slt"
    }
  ],
  "triggers": {
    "crons": ["0 9 * * *"]
  }
}
